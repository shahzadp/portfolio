{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:generate && next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "preview": "node scripts/preview.mjs --port=4321",
    "preview:lan": "node scripts/preview.mjs --host=0.0.0.0 --port=4321",
    "review": "node scripts/review-shots.mjs",
    "review:icons": "node scripts/review-icons.mjs",
    "dev:lan": "npm run db:generate && next dev -H 0.0.0.0 -p 3000",
    "db:seed": "node scripts/db/seed.mjs",
    "db:generate": "node scripts/db/generate.mjs",
    "db:query": "node scripts/db/query.mjs",
    "db:reset": "npm run db:seed && npm run db:generate",
    "cv": "node scripts/cv/build.mjs",
    "icons": "node scripts/icons/build.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test --project=desktop-chrome --project=desktop-wide",
    "test:mobile": "playwright test --project=phone-chrome --project=phone-webkit --project=tablet-chrome",
    "test:report": "playwright show-report",
    "test:update-snapshots": "playwright test --update-snapshots"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
